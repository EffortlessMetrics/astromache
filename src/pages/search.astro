---
import Publication from "../layouts/Publication.astro";
---
<Publication title="Search — Field Notes" description="Search publication notes.">
<h1>Search notes</h1><form id="search-form"><label for="query">Search</label><input id="query" name="query" type="search" /><button>Search</button></form><p id="search-status" role="status"></p><ul id="search-results"></ul>
</Publication>
<script>
import { createStaticIndexLoader, createStaticSearchBackend } from "@effortlessmetrics/static-search";
type Note = { title: string; text: string; url: string };
const index = createStaticIndexLoader<Note[]>({
  load: async (signal) => {
    const response = await fetch("/search-index.json", { signal });
    if (!response.ok) throw new Error("Index unavailable");
    const snapshot = await response.json();
    // Validate the application's document contract before the shared loader
    // caches it. An invalid snapshot must remain retryable on the next submit.
    if (
      !snapshot ||
      typeof snapshot.version !== "string" ||
      !snapshot.version ||
      !Array.isArray(snapshot.data) ||
      !snapshot.data.every(
        (note: unknown) =>
          note !== null &&
          typeof note === "object" &&
          "title" in note &&
          typeof note.title === "string" &&
          "text" in note &&
          typeof note.text === "string" &&
          "url" in note &&
          typeof note.url === "string" &&
          // Generated links are root-relative note paths. This also excludes
          // executable schemes and external/protocol-relative destinations.
          note.url.startsWith("/notes/"),
      )
    )
      throw new Error("Invalid search index");
    return snapshot;
  },
});
const backend = createStaticSearchBackend({
  index,
  createFallback: (snapshot) => ({
    search: (query) =>
      snapshot.data.filter((note) =>
        (note.title + " " + note.text).toLocaleLowerCase().includes(query.toLocaleLowerCase()),
      ),
  }),
  getAllDocuments: (snapshot) => snapshot.data,
});
const form = document.querySelector<HTMLFormElement>("#search-form")!;
const input = document.querySelector<HTMLInputElement>("#query")!;
const status = document.querySelector<HTMLElement>("#search-status")!;
const list = document.querySelector<HTMLUListElement>("#search-results")!;
let request = 0;
let abort: AbortController | undefined;
let submittedQuery: string | null = null;
const rememberReturn = () => {
  if (submittedQuery !== null) {
    try {
      sessionStorage.setItem("field-notes-search-query", submittedQuery);
    } catch {
      // A failed replacement must not replay an older query on a fresh visit.
      try {
        sessionStorage.removeItem("field-notes-search-query");
      } catch {}
    }
  }
  try {
    sessionStorage.setItem("field-notes-back", location.pathname + location.search);
  } catch {}
};
const search = async () => {
  abort?.abort();
  const controller = new AbortController();
  abort = controller;
  const query = input.value;
  submittedQuery = query;
  rememberReturn();
  const generation = ++request;
  list.replaceChildren();
  status.textContent = "Searching…";
  form.setAttribute("aria-busy", "true");
  try {
    await backend.init({ signal: controller.signal });
    if (generation !== request || controller.signal.aborted) return;
    const results = await backend.search(query, {}, { signal: controller.signal });
    if (generation !== request || controller.signal.aborted) return;
    list.replaceChildren(
      ...results.map((note) => {
        const li = document.createElement("li");
        const link = document.createElement("a");
        link.href = note.url;
        link.textContent = note.title;
        li.append(link);
        return li;
      }),
    );
    status.textContent = results.length + " results";
  } catch {
    if (generation === request && !controller.signal.aborted)
      status.textContent = "Search unavailable";
  } finally {
    if (generation === request) {
      abort = undefined;
      form.setAttribute("aria-busy", "false");
    }
  }
};
form.addEventListener("submit", (event) => {
  event.preventDefault();
  void search();
});
window.addEventListener("pageshow", (event) => {
  if (!event.persisted) {
    try {
      submittedQuery = sessionStorage.getItem("field-notes-search-query");
    } catch {}
  }
  if (submittedQuery !== null) {
    input.value = submittedQuery;
    if (!event.persisted) void search();
  }
  // A retained document keeps its results (or failure). Reassert its own
  // submitted query after another listing or search changed the return context.
  rememberReturn();
});
window.addEventListener("pagehide", (event) => {
  if (abort) {
    abort.abort();
    abort = undefined;
    status.textContent = "";
    form.setAttribute("aria-busy", "false");
  }
  ++request;
  if (!event.persisted) backend.dispose();
});
</script>

