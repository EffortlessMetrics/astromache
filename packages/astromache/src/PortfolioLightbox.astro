---
export interface PortfolioLightboxItem {
  title: string;
  medium: string;
  intent: string;
  alt: string;
  src: string;
  tools?: string[];
}

export interface Props {
  items: PortfolioLightboxItem[];
}

const { items } = Astro.props as Props;
---

<dialog
  id="portfolio-lightbox"
  class="portfolio-lightbox rounded-[1.5rem] border border-border bg-background p-0 text-foreground shadow-[0_40px_120px_-48px_rgba(15,23,42,0.95)]"
  aria-labelledby="portfolio-lightbox-title"
>
  <div class="flex items-center justify-end border-b border-border px-4 py-3">
    <button
      id="portfolio-lightbox-close"
      type="button"
      class="hover:bg-card/70 inline-flex items-center rounded-full border border-border px-3 py-1.5 text-sm font-medium text-secondary transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
    >
      Close
    </button>
  </div>

  <div
    class="grid max-h-[calc(100dvh-6rem)] gap-0 overflow-auto lg:grid-cols-[minmax(0,1.6fr)_minmax(18rem,0.95fr)]"
  >
    <figure class="bg-card/40 p-4 sm:p-6">
      <img
        id="portfolio-lightbox-image"
        class="bg-card h-auto w-full rounded-[1.25rem] border border-border object-cover"
        alt=""
        loading="eager"
      />
    </figure>

    <div class="flex flex-col gap-4 px-6 py-6 sm:px-8">
      <p
        id="portfolio-lightbox-medium"
        class="text-xs font-semibold tracking-[0.3em] text-secondary uppercase"
      >
      </p>
      <h2
        id="portfolio-lightbox-title"
        class="text-3xl font-semibold tracking-tight text-heading"
      >
      </h2>
      <p
        id="portfolio-lightbox-intent"
        class="text-base leading-7 text-secondary"
      >
      </p>
      <ul id="portfolio-lightbox-tools" class="flex flex-wrap gap-2" hidden>
      </ul>
    </div>
  </div>
</dialog>

<style>
  .portfolio-lightbox {
    background:var(--portfolio-background,Canvas);
    color:var(--portfolio-foreground,CanvasText);
    border:1px solid var(--portfolio-border,currentColor);
    padding:1rem;
    inset: 0;
    max-height: calc(100dvh - 2rem);
    max-width: calc(100vw - 2rem);
    margin: auto;
    width: min(1200px, calc(100vw - 2rem));
  }

  .portfolio-lightbox::backdrop {
    background: rgba(7, 10, 18, 0.82);
    backdrop-filter: blur(10px);
  }
  .portfolio-lightbox > div:first-child {display:flex;justify-content:flex-end;}
  .portfolio-lightbox > div:nth-child(2) {max-height:calc(100dvh - 8rem);overflow:auto;}
  .portfolio-lightbox figure {margin:1rem 0;}
  .portfolio-lightbox img {width:100%;height:auto;max-height:65dvh;object-fit:contain;}
  .portfolio-lightbox ul {list-style:none;display:flex;flex-wrap:wrap;gap:0.5rem;padding:0;}
  .portfolio-lightbox ul[hidden] {display:none;}
</style>

<script define:vars={{ items }}>
  const lightboxItems = items;

  const initPortfolioLightbox = () => {
    const dialog = document.getElementById("portfolio-lightbox");
    if (!(dialog instanceof HTMLDialogElement)) return;

    const image = document.getElementById("portfolio-lightbox-image");
    const title = document.getElementById("portfolio-lightbox-title");
    const medium = document.getElementById("portfolio-lightbox-medium");
    const intent = document.getElementById("portfolio-lightbox-intent");
    const tools = document.getElementById("portfolio-lightbox-tools");
    const closeButton = document.getElementById("portfolio-lightbox-close");

    if (
      !(image instanceof HTMLImageElement) ||
      !(title instanceof HTMLElement) ||
      !(medium instanceof HTMLElement) ||
      !(intent instanceof HTMLElement) ||
      !(tools instanceof HTMLElement) ||
      !(closeButton instanceof HTMLButtonElement)
    ) {
      return;
    }

    if (dialog.dataset.lightboxBound !== "true") {
      closeButton.addEventListener("click", () => dialog.close());

      dialog.addEventListener("click", event => {
        if (event.target !== dialog) return;
        const rect = dialog.getBoundingClientRect();
        const insideBounds =
          event.clientX >= rect.left &&
          event.clientX <= rect.right &&
          event.clientY >= rect.top &&
          event.clientY <= rect.bottom;

        if (!insideBounds) {
          dialog.close();
        }
      });

      dialog.dataset.lightboxBound = "true";
    }

    const renderItem = index => {
      const item = lightboxItems[index];
      if (!item) return;

      image.src = item.src;
      image.alt = item.alt;
      title.textContent = item.title;
      medium.textContent = item.medium;
      intent.textContent = item.intent;

      tools.replaceChildren();

      if (Array.isArray(item.tools) && item.tools.length > 0) {
        for (const label of item.tools) {
          const chip = document.createElement("li");
          chip.className =
            "rounded-full border border-border px-3 py-1 text-xs font-medium tracking-[0.18em] text-secondary uppercase";
          chip.textContent = label;
          tools.append(chip);
        }
        tools.hidden = false;
      } else {
        tools.hidden = true;
      }
    };

    document.querySelectorAll("[data-portfolio-trigger]").forEach(trigger => {
      if (!(trigger instanceof HTMLElement)) return;
      if (trigger.dataset.lightboxBound === "true") return;

      trigger.addEventListener("click", () => {
        const rawIndex = trigger.dataset.portfolioTrigger;
        const index = Number(rawIndex);
        if (!Number.isFinite(index)) return;
        renderItem(index);
        dialog.showModal();
      });

      trigger.dataset.lightboxBound = "true";
    });
  };

  initPortfolioLightbox();
  document.addEventListener("astro:page-load", initPortfolioLightbox);
  document.addEventListener("astro:after-swap", initPortfolioLightbox);
</script>

